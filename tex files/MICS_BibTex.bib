	note = {0 citations (Crossref) [2023-08-29]
0 citations (Semantic Scholar/DOI) [2023-08-29]},
	keywords = {Few-shot learning, Knowledge graph embedding, Uncertain knowledge graph},
	pages = {16--28},
}

