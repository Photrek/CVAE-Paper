@article{rosenbaumRelationshipPredictiveCoding2022,
	title = {On the relationship between predictive coding and backpropagation},
	volume = {17},
	issn = {1932-6203},
	url = {https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0266102},
	doi = {10.1371/journal.pone.0266102},
	abstract = {Artificial neural networks are often interpreted as abstract models of biological neuronal networks, but they are typically trained using the biologically unrealistic backpropagation algorithm and its variants. Predictive coding has been proposed as a potentially more biologically realistic alternative to backpropagation for training neural networks. This manuscript reviews and extends recent work on the mathematical relationship between predictive coding and backpropagation for training feedforward artificial neural networks on supervised learning tasks. Implications of these results for the interpretation of predictive coding and deep neural networks as models of biological learning are discussed along with a repository of functions, Torch2PC, for performing predictive coding with PyTorch neural network models.},
	number = {3},
	urldate = {2025-11-07},
	journal = {PLOS ONE},
	publisher = {Public Library of Science},
	author = {Rosenbaum, Robert},
	month = mar,
	year = {2022},
	keywords = {Algorithms, Artificial neural networks, Coding mechanisms, Coding theory, Convolutional coding, Covariance, Feedforward neural networks, Neural networks},
	pages = {e0266102},
}

@misc{millidgePredictiveCodingFuture2022,
	title = {Predictive {Coding}: {Towards} a {Future} of {Deep} {Learning} beyond {Backpropagation}?},
	shorttitle = {Predictive {Coding}},
	url = {http://arxiv.org/abs/2202.09467},
	doi = {10.48550/arXiv.2202.09467},
	abstract = {The backpropagation of error algorithm used to train deep neural networks has been fundamental to the successes of deep learning. However, it requires sequential backward updates and non-local computations, which make it challenging to parallelize at scale and is unlike how learning works in the brain. Neuroscience-inspired learning algorithms, however, such as {\textbackslash}emph\{predictive coding\}, which utilize local learning, have the potential to overcome these limitations and advance beyond current deep learning technologies. While predictive coding originated in theoretical neuroscience as a model of information processing in the cortex, recent work has developed the idea into a general-purpose algorithm able to train neural networks using only local computations. In this survey, we review works that have contributed to this perspective and demonstrate the close theoretical connections between predictive coding and backpropagation, as well as works that highlight the multiple advantages of using predictive coding models over backpropagation-trained neural networks. Specifically, we show the substantially greater flexibility of predictive coding networks against equivalent deep neural networks, which can function as classifiers, generators, and associative memories simultaneously, and can be defined on arbitrary graph topologies. Finally, we review direct benchmarks of predictive coding networks on machine learning classification tasks, as well as its close connections to control theory and applications in robotics.},
	urldate = {2025-11-07},
	publisher = {arXiv},
	author = {Millidge, Beren and Salvatori, Tommaso and Song, Yuhang and Bogacz, Rafal and Lukasiewicz, Thomas},
	month = feb,
	year = {2022},
	note = {arXiv:2202.09467 [cs]},
	keywords = {Computer Science - Artificial Intelligence, Computer Science - Machine Learning, Computer Science - Neural and Evolutionary Computing},
}

@article{smithRecentAdvancesApplication2021,
	title = {Recent advances in the application of predictive coding and active inference models within clinical neuroscience},
	volume = {75},
	copyright = {© 2020 The Authors Psychiatry and Clinical Neurosciences © 2020 Japanese Society of Psychiatry and Neurology},
	issn = {1440-1819},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/pcn.13138},
	doi = {10.1111/pcn.13138},
	abstract = {Research in clinical neuroscience is founded on the idea that a better understanding of brain (dys)function will improve our ability to diagnose and treat neurological and psychiatric disorders. In recent years, neuroscience has converged on the notion that the brain is a ‘prediction machine,’ in that it actively predicts the sensory input that it will receive if one or another course of action is chosen. These predictions are used to select actions that will (most often, and in the long run) maintain the body within the narrow range of physiological states consistent with survival. This insight has given rise to an area of clinical computational neuroscience research that focuses on characterizing neural circuit architectures that can accomplish these predictive functions, and on how the associated processes may break down or become aberrant within clinical conditions. Here, we provide a brief review of examples of recent work on the application of predictive processing models of brain function to study clinical (psychiatric) disorders, with the aim of highlighting current directions and their potential clinical utility. We offer examples of recent conceptual models, formal mathematical models, and applications of such models in empirical research in clinical populations, with a focus on making this material accessible to clinicians without expertise in computational neuroscience. In doing so, we aim to highlight the potential insights and opportunities that understanding the brain as a prediction machine may offer to clinical research and practice.},
	number = {1},
	urldate = {2025-11-07},
	journal = {Psychiatry and Clinical Neurosciences},
	author = {Smith, Ryan and Badcock, Paul and Friston, Karl J.},
	year = {2021},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/pcn.13138},
	keywords = {active inference, computational neuroscience, computational psychiatry, emotion, predictive coding},
	pages = {3--13},
}

@misc{hanelGeneralizedBoltzmannFactors2006,
	title = {Generalized {Boltzmann} factors and the maximum entropy principle},
	url = {http://arxiv.org/abs/cond-mat/0602389},
	doi = {10.48550/arXiv.cond-mat/0602389},
	abstract = {We generalize the usual exponential Boltzmann factor to any reasonable and potentially observable distribution function, \$B(E)\$. By defining generalized logarithms \${\textbackslash}Lambda\$ as inverses of these distribution functions, we are led to a generalization of the classical Boltzmann-Gibbs entropy, \$S\_\{BG\}= -{\textbackslash}int d {\textbackslash}epsilon {\textbackslash}omega({\textbackslash}epsilon) B({\textbackslash}epsilon) {\textbackslash}log B({\textbackslash}epsilon)\$ to the expression \$S{\textbackslash}equiv -{\textbackslash}int d {\textbackslash}epsilon {\textbackslash}omega({\textbackslash}epsilon) {\textbackslash}int\_0{\textasciicircum}\{B({\textbackslash}epsilon)\} dx {\textbackslash}Lambda (x)\$, which contains the classical entropy as a special case. We demonstrate that this entropy has two important features: First, it describes the correct thermodynamic relations of the system, and second, the observed distributions are straight forward solutions to the Jaynes maximum entropy principle with the ordinary (not escort!) constraints. Tsallis entropy is recovered as a further special case.},
	urldate = {2025-11-06},
	publisher = {arXiv},
	author = {Hanel, Rudolf and Thurner, Stefan},
	month = jul,
	year = {2006},
	note = {arXiv:cond-mat/0602389},
	keywords = {Condensed Matter - Statistical Mechanics},
}

