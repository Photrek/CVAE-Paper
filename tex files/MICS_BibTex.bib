@article{buthInfomeasureComprehensivePython2025,
	title = {infomeasure: a comprehensive {Python} package for information theory measures and estimators},
	volume = {15},
	copyright = {2025 The Author(s)},
	issn = {2045-2322},
	shorttitle = {infomeasure},
	url = {https://www.nature.com/articles/s41598-025-14053-5},
	doi = {10.1038/s41598-025-14053-5},
	abstract = {Information theory, i.e. the mathematical analysis of information and of its processing, has become a tenet of modern science; yet, its use in real-world studies is usually hindered by its computational complexity, the lack of coherent software frameworks, and, as a consequence, low reproducibility. We here introduce infomeasure, an open-source Python package designed to provide robust tools for calculating a wide variety of information-theoretic measures, including entropies, mutual information, transfer entropy and divergences. It is designed for both discrete and continuous variables; implements state-of-the-art estimation techniques; and allows the calculation of local measure values, p-values and t-scores. By unifying these approaches under one consistent framework, infomeasure aims to mitigate common pitfalls, ensure reproducibility, and simplify the practical implementation of information-theoretic analyses. In this contribution, we explore the motivation and features of infomeasure; its validation, using known analytical solutions; and exemplify its utility in a case study involving the analysis of human brain time series.},
	language = {en},
	number = {1},
	urldate = {2025-09-01},
	journal = {Scientific Reports},
	publisher = {Nature Publishing Group},
	author = {Büth, Carlson Moses and Acharya, Kishor and Zanin, Massimiliano},
	month = aug,
	year = {2025},
	keywords = {Information theory and computation, Neurological disorders, Nonlinear phenomena, Statistical physics},
	pages = {29323},
}

@article{encisoUniquenessCharacterizationTheorems2017,
	title = {Uniqueness and {Characterization} {Theorems} for {Generalized} {Entropies}},
	volume = {2017},
	doi = {10.1088/1742-5468/aa967f},
	abstract = {The requirement that an entropy function be composable is key: it means that the entropy of a compound system can be calculated in terms of the entropy of its independent components. We prove that, under mild regularity assumptions, the only composable generalized entropy in trace form is the Tsallis one-parameter family (which contains Boltzmann–Gibbs as a particular case). This result leads to the use of generalized entropies that are not of trace form, such as Rényi's entropy, in the study of complex systems. In this direction , we also present a characterization theorem for a large class of composable non-trace-form entropy functions with features akin to those of Rényi's entropy.},
	journal = {Journal of Statistical Mechanics: Theory and Experiment},
	author = {Enciso, Alberto and Tempesta, Piergiulio},
	month = feb,
	year = {2017},
}

@article{cohenStatisticsDynamics2002,
	series = {Non {Extensive} {Thermodynamics} and {Physical} applications},
	title = {Statistics and dynamics},
	volume = {305},
	issn = {0378-4371},
	url = {https://www.sciencedirect.com/science/article/pii/S0378437101006343},
	doi = {10.1016/S0378-4371(01)00634-3},
	abstract = {The classical statistics of Boltzmann and Gibbs will be discussed. As pointed out long ago by Einstein, there is a connection of the statistics applicable to a system and its underlying dynamics. This follows, for example, from the existence of quantum (Bose–Einstein or Fermi–Dirac) statistics, where the underlying dynamics is quite different from classical mechanics. In 1988 Tsallis proposed a very successful new statistics. Its connection with an underlying dynamics as well as with the nonextensivity of systems are still matters of active investigation.},
