@phdthesis{ketemaGeometrieLinformationPour2026,
	address = {Toulouse, France},
	type = {Doctoral},
	title = {Géométrie de l'information pour la robustesse de modèle numérique face à l'incertitude de loi},
	abstract = {Considering a parametric family F as the space of perturbed distributions, a novel distributional robustness analysis method is proposed which exploits the information-geometric structure of F . Focusing mainly on a quantile on the model’s output, this method consists in maximizing the output quantile on F , seen as a Riemannian manifold, using stochastic optimization techniques. In addition, for better guarantees on the computed maximum quantile value, we propose a non-asymptotic confidence interval that is valid under distributional shifts of the maximizing distribution. Finally, this novel method is applied to a safety case study related to the loss of coolant accident simulation in a nuclear reactor.},
	language = {en},
	school = {Université de Toulouse},
	author = {Ketema, Baalu Belay},
	month = feb,
	year = {2026},
}

@article{borlandItoLangevinEquationsGeneralized1998,
	title = {Ito-{Langevin} equations within generalized thermostatistics},
	volume = {245},
	issn = {0375-9601},
	url = {https://www.sciencedirect.com/science/article/pii/S0375960198004678},
	doi = {10.1016/S0375-9601(98)00467-8},
	abstract = {An entire family of microscopic Langevin equations is shown here to give rise to Tsallis-type macroscopic distributions (∝ [1−β(1−q)U(x)]1(1−q), U(x) being the potential) as exact stationary solution to the standard linear Fokker-Planck equation. This is the result of a specific interplay between the underlying deterministic and stochastic forces for which the stationary solution becomes identical to that of a nonlinear diffusion process. The fact that a process stemming from the standard theory of Fokker-Planck equations, usually associated with Boltzmann-Gibbs statistics, can equivalently be viewed within the non-extensive scenario of generalized thermostatistics is emphasized. This greatly enhances the understanding of the types of physical processes which can naturally be described within that framework. Furthermore, it is shown specifically that a slight change in the microscopic dynamics of a system following Boltzmann-Gibbs statistics may lead to Tsallis statistics. The Tsallis index q is directly determined by the coefficients of the underlying forces.},
	number = {1},
	urldate = {2026-02-21},
	journal = {Physics Letters A},
	author = {Borland, Lisa},
	month = aug,
	year = {1998},
	pages = {67--72},
}

