	language = {en},
	number = {7},
	urldate = {2025-05-23},
	journal = {Entropy},
	author = {Kalogeropoulos, Nikolaos},
	month = jul,
	year = {2017},
	keywords = {Legendre transform, Tsallis entropy, complex systems, convexity, statistical mechanics},
	pages = {298},
}

