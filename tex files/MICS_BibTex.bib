	volume = {55},
	doi = {10.1140/epjb/e2006-00205-y},
	abstract = {We present results about financial market observables, specifically returns and traded volumes. They are obtained within the current nonextensive statistical mechanical framework based on the entropy Sq = k 1− W i=1 p q i 1−q (q ∈ ∈) S1 ≡ SBG = −k W i=1 pi ln pi. More precisely, we present stochastic dynamical mechanisms which mimic probability density functions empirically observed. These mechanisms provide possible interpretations for the emergence of the entropic indices q in the time evolution of the corresponding observables. In addition to this, through multi-fractal analysis of return time series, we verify that the dual relation qstat + qsens = 2 is numerically satisfied, qstat and qsens being associated to the probability density function and to the sensitivity to initial conditions respectively. This type of simple relation, whose understanding remains ellusive, has been empirically verified in various other systems.},
