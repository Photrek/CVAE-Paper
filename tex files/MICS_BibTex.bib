@misc{dogniniCloserLookInfluence2026,
	title = {A {Closer} {Look} on the {Influence} of {Constraints} {Upon} the {Optimization} of the {Nonadditive} {Entropic} {Functional} \${S}\_\{q\}\$},
	url = {http://arxiv.org/abs/2605.08860},
	doi = {10.48550/arXiv.2605.08860},
	abstract = {The thermal-equilibrium canonical distribution is currently obtained by maximizing the Boltzmann-Gibbs-von Neumann-Shannon entropy \$S\_\{BG\}(p)=k{\textbackslash}sum{\textasciicircum}\{W\}\_\{i=1\}p\_\{i\}{\textbackslash}ln 1/p\_\{i\}\$ constrained to \${\textbackslash}sum{\textasciicircum}\{W\}\_\{i=1\}p\_\{i\}=1\$ and \${\textbackslash}sum{\textasciicircum}\{W\}\_\{i=1\}p\_\{i\}{\textbackslash},e\_\{i\}=U\$, \$e\_\{1\}{\textbackslash}leq{\textbackslash}ldots{\textbackslash}leq e\_\{W\}\$ being the energies of the \$W\$ possible states and \$U{\textbackslash}in[e\_\{1\},e\_\{W\}]\$ their mean value. We revisit a generalized version of this optimization problem grounded in the nonadditive entropy \$S\_\{q\}(p)=k{\textbackslash},({\textbackslash}sum{\textasciicircum}\{W\}\_\{i=1\}p\_\{i\}{\textasciicircum}\{q\}-1)/(1-q)\$ (frequently, though not necessarily, \$q{\textbackslash}in(0,1)\$; \$S\_1=S\_\{BG\}\$), and the constraint \${\textbackslash}sum{\textasciicircum}\{W\}\_\{i=1\} p\_\{i\}{\textasciicircum}\{q{\textasciicircum}\{{\textbackslash}prime\}\}e\_\{i\} / {\textbackslash}sum{\textasciicircum}\{W\}\_\{i=1\}p\_\{i\}{\textasciicircum}\{q{\textasciicircum}\{{\textbackslash}prime\}\}=U\$, \$q{\textasciicircum}\{{\textbackslash}prime\}{\textgreater}0\$. Sufficient conditions for existence, strict positivity, and uniqueness of solutions are derived, along with a theorem that enables their closed-form calculation. We apply these results to deepen the understanding of the two standard cases in the literature (\$q{\textasciicircum}\{{\textbackslash}prime\}=1\$ and \$q{\textasciicircum}\{{\textbackslash}prime\}=q\$), as well as of a new one (\$q{\textasciicircum}\{{\textbackslash}prime\}=2-q\$). We prove that these standard cases are the only ones yielding optimizing probability distributions of \$q\$-exponential form. Furthermore, we define an effective temperature \$T\_\{q,q{\textasciicircum}\{{\textbackslash}prime\}\}\$ through a Clausius-like relation \$1/T\_\{q,q{\textasciicircum}\{{\textbackslash}prime\}\}={\textbackslash}partial S\_\{q\} / {\textbackslash}partial U\$ and derive a Helmholtz-like energy \$F\_\{q,q{\textasciicircum}\{{\textbackslash}prime\}\}=U-T\_\{q,q{\textasciicircum}\{{\textbackslash}prime\}\}S\_\{q\}\$, with the former grounding the validity of the \$0{\textasciicircum}\{th\}\$ Principle of Thermodynamics within this generalized statistical mechanics. Finally, we show that the case with a linear constraint (i.e., \$q{\textasciicircum}\{{\textbackslash}prime\}=1\$) with \$q{\textbackslash}in(0,1)\$ (i) preserves the Third Law of Thermodynamics; (ii) can be used to model classical many-body Hamiltonian systems with arbitrarily-ranged interactions; and (iii) resembles features of low-dimensional nonlinear dynamical systems at the edge of chaos.},
	urldate = {2026-05-20},
	author = {Dognini, Leandro Lyra Braga and Tsallis, Constantino},
	month = may,
	year = {2026},
	note = {arXiv:2605.08860 [cond-mat.stat-mech]},
	keywords = {Condensed Matter - Statistical Mechanics, Mathematical Physics},
}

