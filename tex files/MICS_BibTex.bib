@book{polyanskiyInformationTheoryCoding2025,
	address = {Cambridge, United Kingdom ; New York, NY},
	title = {Information {Theory}: {From} {Coding} to {Learning}},
	isbn = {978-1-108-83290-8},
	shorttitle = {Information {Theory}},
	abstract = {This enthusiastic introduction to the fundamentals of information theory builds from classical Shannon theory through to modern applications in statistical learning, equipping students with a uniquely well-rounded and rigorous foundation for further study. Introduces core topics such as data compression, channel coding, and rate-distortion theory using a unique finite block-length approach. With over 210 end-of-part exercises and numerous examples, students are introduced to contemporary applications in statistics, machine learning and modern communication theory. This textbook presents information-theoretic methods with applications in statistical learning and computer science, such as f-divergences, PAC Bayes and variational principle, Kolmogorov's metric entropy, strong data processing inequalities, and entropic upper bounds for statistical estimation. Accompanied by a solutions manual for instructors, and additional standalone chapters on more specialized topics in information theory, this is the ideal introductory textbook for senior undergraduate and graduate students in electrical engineering, statistics, and computer science.},
	language = {English},
	publisher = {Cambridge University Press},
	author = {Polyanskiy, Yury and Wu, Yihong},
	year = {2025},
}

@article{medeirosDamageSpreadingMajorityvote2005,
	title = {Damage spreading in the majority-vote model on small-world networks},
	volume = {348},
	issn = {0378-4371},
	url = {https://www.sciencedirect.com/science/article/pii/S0378437104013172},
	doi = {10.1016/j.physa.2004.10.004},
	abstract = {We use the damage spreading technique to study the dynamical phase diagram and critical behavior of the isotropic majority-vote model on small-world networks generated by rewiring two-dimensional square lattices. The phase diagram exhibits a chaotic-frozen phase transition at a critical noise parameter qc(p) which is a monotonically increasing function of the probability p of having long-range interactions. For the correlation length critical exponent, we obtain the mean-field value ν=12, for all systems with p{\textgreater}0, whereas the exponent ratio β/ν and the dynamical critical exponent z are both dependent on the fraction of shortcuts introduced in the system.},
